{
  "openapi": "3.1.0",
  "info": {
    "title": "基金数据只读接口（ChatGPT 专用精简版）",
    "version": "2.4.0",
    "description": "本文件是 ChatGPT 专用精简 schema，只暴露 9 个安全端点；完整版（13 个端点，含全部接口）见 /openapi.json，供网页版与其他消费者使用。已从本文件物理移除的端点：getFundNavSeriesAll（响应约 839KB，必超单响应上限）、getDailySignals（约 94KB，贴线）、getRules（与 rules_core/分页重复）、getFundValuations（估值结论已在 getDailySignalsBrief 内）。【建议调用顺序】①每次会话开始：getRulesCore（约 20KB，核心阈值与待确认参数）→ getDailySignalsBrief（约 41KB，21 只基金次日信号与档位）；②需要规则原文：getRulesFullTextIndex → 按 total_pages 逐页 getRulesFullTextPage（正文一字不差）；③需要净值/分位：getFundSummary；④需要成立以来历史：getFundHistoryIndex → getFundHistoryPage；⑤需要近 1 年序列：getFundNavSeriesByCode；⑥需要多窗口业绩：getFundPerformance。【硬约束】本接口只读，不含任何持仓金额/份额/成本；止盈只给比例，卖出金额须结合私有持仓接口。任何基金一律同时给出 6 位代码与中文全称。规则只有一个总版本号 V6.3。"
  },
  "servers": [
    {
      "url": "https://raw.githubusercontent.com/qiqi01792/fund-data-api/main"
    }
  ],
  "paths": {
    "/api/performance.json": {
      "get": {
        "operationId": "getFundPerformance",
        "summary": "获取全部基金多窗口业绩指标（阶段收益/最大回撤/年化波动率）",
        "description": "返回 21 只基金在 1m/3m/6m/1y/3y/5y/10y/成立以来 各窗口的阶段收益率、年化收益率、最大回撤（含起止日期）、年化波动率与窗口记录数。基于成立以来完整净值计算，优先累计净值口径（分红再投）。适合评估基金历史表现与风险。",
        "responses": {
          "200": {
            "description": "多窗口业绩指标 JSON",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "schema": {
                      "type": "string",
                      "description": "数据结构标识，固定 fund-performance/v1"
                    },
                    "readonly": {
                      "type": "boolean",
                      "description": "是否只读接口，固定 true"
                    },
                    "generated_at": {
                      "type": "string",
                      "description": "接口生成时间"
                    },
                    "as_of_nav_date": {
                      "type": "string",
                      "description": "数据最新净值日期"
                    },
                    "nav_basis": {
                      "type": "string",
                      "description": "净值口径说明（优先累计净值）"
                    },
                    "return_formula": {
                      "type": "string",
                      "description": "阶段收益率公式"
                    },
                    "max_drawdown_formula": {
                      "type": "string",
                      "description": "最大回撤公式"
                    },
                    "volatility_formula": {
                      "type": "string",
                      "description": "年化波动率公式"
                    },
                    "annualized_formula": {
                      "type": "string",
                      "description": "年化收益公式与适用条件"
                    },
                    "windows_defined": {
                      "type": "object",
                      "description": "窗口定义：各窗口对应的自然日回退天数"
                    },
                    "notes": {
                      "type": "object",
                      "description": "口径与使用限制说明（窗口回退/缺失日/分红基金/不含持仓）"
                    },
                    "funds": {
                      "type": "array",
                      "description": "逐基金多窗口业绩指标",
                      "items": {
                        "type": "object",
                        "properties": {
                          "fund_code": {
                            "type": "string",
                            "description": "基金代码"
                          },
                          "fund_name": {
                            "type": "string",
                            "description": "基金名称"
                          },
                          "nav_basis_used": {
                            "type": "string",
                            "description": "该基金使用的净值口径：accumulated_nav（累计净值，分红再投）或 unit_nav"
                          },
                          "history_start_date": {
                            "type": "string",
                            "description": "成立以来首条净值日期"
                          },
                          "history_end_date": {
                            "type": "string",
                            "description": "最新净值日期"
                          },
                          "records_total": {
                            "type": "integer",
                            "description": "成立以来净值记录总数"
                          },
                          "windows": {
                            "type": "object",
                            "description": "各窗口指标：1m/3m/6m/1y/3y/5y/10y/since_inception，每项含阶段收益率/年化/最大回撤及其起止日/年化波动率/记录数"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/rules_core.json": {
      "get": {
        "operationId": "getRulesCore",
        "summary": "获取策略规则结构化核心（轻量版，ChatGPT 日常入口）",
        "description": "返回核心阈值（定投 70%停/65%复、V5.8 六档补仓金额表与评级修正、V6.1 七档累计止盈阶梯与公式、V6.2 三关过滤）、当前定投计划、暂停定投说明、待确认参数清单、V6.2 估值模块与规则全文分页索引。响应约 20KB，适合每次会话开始时调用。需要规则原文时按 full_text_pages 分页读取。",
        "responses": {
          "200": {
            "description": "策略规则结构化核心 JSON",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "schema": {
                      "type": "string",
                      "description": "数据结构标识"
                    },
                    "readonly": {
                      "type": "boolean",
                      "description": "是否只读，固定 true"
                    },
                    "generated_at": {
                      "type": "string",
                      "description": "接口生成时间"
                    },
                    "rules_version": {
                      "type": "string",
                      "description": "规则总版本号（rules_core / rules_fulltext 适用）"
                    },
                    "signals": {
                      "type": "array",
                      "description": "逐基金信号数组（signals_brief 适用），每项含 fund_code/fund_name 与决策字段",
                      "items": {
                        "type": "object"
                      }
                    },
                    "content": {
                      "type": "string",
                      "description": "规则正文内容（rules_fulltext/page 适用，Markdown）"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/rules_fulltext/index.json": {
      "get": {
        "operationId": "getRulesFullTextIndex",
        "summary": "获取规则完整全文的分页索引（正文一字不删）",
        "description": "返回规则全文（V6.3 定稿，含 V5.7/V5.8/V6.1/V6.2 历史归档章节与 V6.3 新增章节）的总页数、总字符数与每页章节标题。按 page 1..total_pages 顺序调用 getRulesFullTextPage 即可拼出完整规则全文。",
        "responses": {
          "200": {
            "description": "规则全文分页索引",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "schema": {
                      "type": "string",
                      "description": "数据结构标识"
                    },
                    "readonly": {
                      "type": "boolean",
                      "description": "是否只读，固定 true"
                    },
                    "generated_at": {
                      "type": "string",
                      "description": "接口生成时间"
                    },
                    "rules_version": {
                      "type": "string",
                      "description": "规则总版本号（rules_core / rules_fulltext 适用）"
                    },
                    "signals": {
                      "type": "array",
                      "description": "逐基金信号数组（signals_brief 适用），每项含 fund_code/fund_name 与决策字段",
                      "items": {
                        "type": "object"
                      }
                    },
                    "content": {
                      "type": "string",
                      "description": "规则正文内容（rules_fulltext/page 适用，Markdown）"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/rules_fulltext/page/{page}.json": {
      "get": {
        "operationId": "getRulesFullTextPage",
        "summary": "获取规则完整全文的指定一页",
        "description": "按页返回规则原文（Markdown），正文与本地正本一字不差。页码从 1 开始，不超过索引中的 total_pages。每页远小于客户端响应上限。",
        "parameters": [
          {
            "name": "page",
            "in": "path",
            "required": true,
            "description": "页码数字（文本形式），从 1 开始，不超过 getRulesFullTextIndex 返回的 total_pages",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "规则全文指定页",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "schema": {
                      "type": "string",
                      "description": "数据结构标识"
                    },
                    "readonly": {
                      "type": "boolean",
                      "description": "是否只读，固定 true"
                    },
                    "generated_at": {
                      "type": "string",
                      "description": "接口生成时间"
                    },
                    "rules_version": {
                      "type": "string",
                      "description": "规则总版本号（rules_core / rules_fulltext 适用）"
                    },
                    "signals": {
                      "type": "array",
                      "description": "逐基金信号数组（signals_brief 适用），每项含 fund_code/fund_name 与决策字段",
                      "items": {
                        "type": "object"
                      }
                    },
                    "content": {
                      "type": "string",
                      "description": "规则正文内容（rules_fulltext/page 适用，Markdown）"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/signals_brief.json": {
      "get": {
        "operationId": "getDailySignalsBrief",
        "summary": "获取每日操作信号精简版（ChatGPT 日常首选入口，约为完整版 1/4 体积）",
        "description": "返回与 getDailySignals 相同的 21 只基金次日信号，但剥离长文案：每只基金保留代码+中文名、最新净值与净值日、历史位置%/近6月位置%、信号方向与档位、信号原因、置信度、连跌天数、止盈状态（档位/累计目标/执行状态/动作建议/基准登记）、估值结论（状态/评分/理由/三关总结果）、定投启停；顶层保留信号统计、月度资金池结论、优先动作、口径分歧清单与公开通道边界说明。金额类字段公开通道一律不输出，止盈只给比例。完整版（含全部字段）请用 getDailySignals。",
        "responses": {
          "200": {
            "description": "每日操作信号精简版 JSON",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "schema": {
                      "type": "string",
                      "description": "数据结构标识"
                    },
                    "readonly": {
                      "type": "boolean",
                      "description": "是否只读，固定 true"
                    },
                    "generated_at": {
                      "type": "string",
                      "description": "接口生成时间"
                    },
                    "rules_version": {
                      "type": "string",
                      "description": "规则总版本号（rules_core / rules_fulltext 适用）"
                    },
                    "signals": {
                      "type": "array",
                      "description": "逐基金信号数组（signals_brief 适用），每项含 fund_code/fund_name 与决策字段",
                      "items": {
                        "type": "object"
                      }
                    },
                    "content": {
                      "type": "string",
                      "description": "规则正文内容（rules_fulltext/page 适用，Markdown）"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
