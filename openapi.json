    "/api/history/{fund_code}/index.json": {
      "get": {
        "operationId": "getFundHistoryIndex",
        "summary": "获取单只基金成立以来完整历史的分页索引",
        "description": "返回该基金全历史的总记录数、总页数、每页大小与首末日期。读取完整历史前先调本接口，再逐页调用 getFundHistoryPage。",
        "parameters": [
          {
            "name": "fund_code",
