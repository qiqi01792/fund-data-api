                          "historical_low": {
                            "type": "string",
                            "description": "成立以来历史最低单位净值"
                          },
                          "historical_low_date": {
                            "type": "string",
                            "description": "历史最低净值日期"
                          },
                          "six_month_start": {
                            "type": "string",
                            "description": "近六个月窗口起始日"
                          },
                          "six_month_end": {
                            "type": "string",
                            "description": "近六个月窗口结束日"
                          },
                          "six_month_high": {
                            "type": "string",
                            "description": "近六个月窗口内最高单位净值"
                          },
                          "six_month_high_date": {
                            "type": "string",
                            "description": "窗口内最高净值日期"
                          },
                          "six_month_low": {
                            "type": "string",
                            "description": "近六个月窗口内最低单位净值"
                          },
                          "six_month_low_date": {
                            "type": "string",
                            "description": "窗口内最低净值日期"
                          },
                          "recent_low": {
                            "type": "string",
                            "description": "近期低点净值（最近 20 个交易日最低正式净值）"
                          },
                          "recent_low_date": {
                            "type": "string",
                            "description": "近期低点出现日期"
                          },
                          "recent_low_window_days": {
                            "type": "integer",
                            "description": "近期低点所用交易日数 N"
                          },
                          "history_start_date": {
                            "type": "string",
                            "description": "该基金历史记录起始日期"
                          },
                          "history_end_date": {
                            "type": "string",
                            "description": "该基金历史记录结束日期"
                          },
                          "history_count": {
                            "type": "integer",
                            "description": "该基金历史记录条数（成立以来口径）"
                          },
                          "historical_position": {
                            "type": "string",
                            "description": "历史净值区间位置，0~1，基于成立以来全历史"
                          },
                          "six_month_position": {
                            "type": "string",
                            "description": "六个月净值区间位置，0~1"
                          },
                          "data_status": {
                            "type": "string",
                            "description": "数据核验状态：正常/待复核/异常"
                          },
                          "update_time": {
                            "type": "string",
                            "description": "本条数据更新时间"
                          }
                        }
                      }
                    },
                    "check_log": {
                      "type": "array",
                      "description": "异常检查记录",
                      "items": {
                        "type": "object",
                        "properties": {
                          "check_time": {
                            "type": "string",
                            "description": "检查时间"
                          },
                          "fund_code": {
                            "type": "string",
                            "description": "基金代码"
                          },
                          "fund_name": {
                            "type": "string",
                            "description": "基金名称"
                          },
                          "check_type": {
                            "type": "string",
                            "description": "异常类型"
                          },
                          "nav_date": {
                            "type": "string",
                            "description": "相关净值日期"
                          },
                          "severity": {
                            "type": "string",
                            "description": "严重程度"
                          },
                          "status": {
                            "type": "string",
                            "description": "处理状态"
                          },
                          "detail": {
                            "type": "string",
                            "description": "异常详情与处理结果"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
